---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { TAG_LABELS } from '../../tags';

const SITE_DESCRIPTION_ZH =
	'Haowei Chan 的個人作品集與部落格，收錄專案、寫作與網頁實驗。';

const posts = (await getCollection('blog'))
	.filter((post) => post.data.lang === 'zh-tw')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredProjects = [
	{
		id: 'tinboker',
		title: 'TinBoker — AI 語音與 Podcast 知識庫平台',
		tagline: '結合非結構化語音轉寫、LangGraph 多 Agent 狀態圖與多層快取的 AI 原生內容處理系統。',
		tags: ['React 19', 'TypeScript', 'Vite', 'FastAPI', 'Python 3.12', 'LangGraph', 'Redis', 'Docker', 'Caddy'],
		highlights: [
			'多 Agent 拓撲分工：過濾廣告贊助、依長度動態合併章節、提煉 3-8 條關鍵洞察。',
			'Step-by-step Checkpoints：儲存 Raw / Checkpoint / Serving 三層狀態，支援失敗重播 (rerun_from)。',
			'高效能快取：FastAPI + Redis 記憶體快取，搭配 Single-Flight 鎖防範快取擊穿。'
		],
		links: [
			{ label: '造訪網站', href: 'https://tinboker.com', external: true },
			{ label: 'GitHub 專案', href: 'https://github.com/HaoweiChan/tinboker', external: true },
			{ label: '技術文章 (上)', href: '/zh-tw/blog/agentic-ingestion-pipeline-part1/' },
			{ label: '技術文章 (下)', href: '/zh-tw/blog/agentic-ingestion-pipeline-part2/' }
		]
	},
	{
		id: 'kuroshio',
		title: 'Kuroshio — 開源 Quantamental 投資組合引擎',
		tagline: '多因子選股、LLM Agent 個股研究與 IPS 驅動的再平衡提案：它只排序、辯論與提案，永遠不下單。',
		tags: ['Python 3.11+', 'Multi-Agent Research', 'IPS Policy Engine', 'Backtest', 'Apache-2.0'],
		highlights: [
			'Screen：美股與台股多因子動能篩選，以橫斷面百分位給分，把不同市場放在同一把尺上比較。',
			'Research：每檔持股跑一次 LLM Agent 研究，facet 級快取讓每日執行的成本以美分計而非美元。',
			'Propose：挑戰者對決最弱持股的換股提案，每張卡片都引用觸發它的 IPS 條款——用資源競爭取代二元否決。'
		],
		links: [
			{ label: 'GitHub 專案', href: 'https://github.com/HaoweiChan/kuroshio', external: true },
			{ label: '線上 Demo', href: 'https://haoweichan.github.io/kuroshio/', external: true }
		]
	},
	{
		id: 'hermes',
		title: 'Hermes Agent — 常駐型個人 AI 助理系統',
		tagline: '雙入口（Discord 聊天視窗 + 排程器）、純文字 Vault 記憶與自動化資產追蹤的個人駐守助理。',
		tags: ['Python 3.11', 'Discord Gateway', 'Cron Scheduler', 'Obsidian Vault', 'Git Sweeper', 'Shioaji API', 'Schwab API'],
		highlights: [
			'頻道即角色 (Channel-as-Persona)：將 Discord 頻道劃分為黑潮交易檯 (#trading)、研報庫 (#reports)、產業分析 (#research)。',
			'自動化資產追蹤：每日定時解密元大電子對帳單 PDF、呼叫 Schwab/Shioaji API，計算 T+2 未交割款並自動繪製資產曲線。',
			'單一 Git Sweeper：寫檔與 Git 操作分離，定時自動 commit/push，杜絕多端寫入衝突。'
		],
		links: [
			{ label: 'hermes-desk (排程層開源)', href: 'https://github.com/HaoweiChan/hermes-desk', external: true },
			{ label: '助理架構文章', href: '/zh-tw/blog/resident-personal-assistant/' },
			{ label: '資產追蹤文章', href: '/zh-tw/blog/broker-reports-and-portfolio-automation/' },
			{ label: 'Hermes Agent (上游)', href: 'https://github.com/NousResearch/hermes-agent', external: true }
		]
	},
	{
		id: 'taifexdesk',
		title: 'TaifexDesk — 台指期／股期／選擇權交易基礎設施',
		tagline: '回測、模擬盤與實單執行共用同一套引擎的台灣期貨交易系統：Python + FastAPI 後端、React 戰情室儀表板、shioaji 券商轉接層。',
		tags: ['Python', 'FastAPI', 'React', 'Shioaji', 'Backtesting', 'Paper Trading', 'Risk Engine'],
		highlights: [
			'訊號與執行分離：策略只是 entry / add / stop 三個 policy 的組合，引擎負責執行、從不產生決策 — 所以引擎能開源，策略不必。',
			'Bar 內停損檢查：從 OHLC 重建盤中價格路徑，最低價跌破停損就算出場，消除只看收盤價回測的系統性樂觀偏誤。',
			'單一成本模型：回測、模擬與實單共用同一份手續費與稅金計算，成本隨指數變動，不會隨行情漂移。'
		],
		links: [{ label: 'GitHub 專案', href: 'https://github.com/HaoweiChan/TaifexDesk', external: true }]
	}
];
---

<!doctype html>
<html lang="zh-tw">
	<head>
		<BaseHead title={`${SITE_TITLE} | 繁體中文`} description={SITE_DESCRIPTION_ZH} />
	</head>
	<body>
		<Header locale="zh-tw" switchHref="/" />
		<main class="home">
			<section class="intro" aria-labelledby="intro-title">
				<p class="eyebrow">作品集與筆記</p>
				<h1 id="intro-title">Haowei Chan</h1>
				<p class="lede">
					我打造實用的網頁產品與 AI 系統，記錄學到的東西，並把專案、技術筆記與小型實驗公開整理在這裡。
				</p>
				<div class="actions" aria-label="主要連結">
					<a class="button" href="/zh-tw/blog">閱讀所有文章</a>
					<a class="button secondary" href="https://github.com/HaoweiChan" target="_blank" rel="noreferrer"
						>查看 GitHub</a
					>
				</div>
			</section>

			<section class="section" aria-labelledby="projects-title">
				<div class="section-heading">
					<p class="eyebrow">精選作品</p>
					<h2 id="projects-title">專案</h2>
				</div>

				<div class="expandable-grid">
					{
						featuredProjects.map((project) => (
							<details class="expand-card project-card" id={`proj-${project.id}`}>
								<summary class="expand-summary">
									<div class="summary-header">
										<h3 class="card-title">{project.title}</h3>
										<span class="chevron" aria-hidden="true" />
									</div>
									<p class="card-tagline">{project.tagline}</p>
									<div class="tag-row">
										{project.tags.map((tag) => (
											<span class="tech-tag">{tag}</span>
										))}
										{project.private && <span class="tech-tag private-tag">{project.private}</span>}
									</div>
								</summary>
								<div class="expand-content">
									<div class="content-block">
										<h4>核心亮點與架構細節</h4>
										<ul>
											{project.highlights.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</div>
									<div class="card-actions" hidden={project.links.length === 0}>
										{project.links.map((link) => (
											<a
												class="action-btn"
												href={link.href}
												target={link.external ? '_blank' : '_self'}
												rel={link.external ? 'noreferrer' : ''}
											>
												{link.label}
											</a>
										))}
									</div>
								</div>
							</details>
						))
					}
				</div>
			</section>

			<section class="section" aria-labelledby="writing-title">
				<div class="section-heading">
					<p class="eyebrow">最新發布</p>
					<h2 id="writing-title">Blog</h2>
				</div>

				<div class="post-list">
					{
						posts.map((post) => (
							<a
								class="post-row"
								href={`/zh-tw/blog/${post.data.translationOf ?? post.id.replace(/^zh-tw\//, '')}/`}
							>
								<div class="post-text">
									<h3 class="post-title">{post.data.title}</h3>
									<p class="post-desc">{post.data.description}</p>
								</div>
								<span class="post-meta">
									<FormattedDate date={post.data.pubDate} locale="zh-TW" />
									{post.data.tags.map((tag) => (
										<span class="post-tag">{TAG_LABELS['zh-tw'][tag]}</span>
									))}
								</span>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer locale="zh-tw" />
	</body>
</html>

<style>
	.home {
		width: 960px;
	}

	.intro {
		padding: 5rem 0 4rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.eyebrow {
		margin: 0 0 0.85rem;
		color: var(--accent-dark);
		font-size: 0.88rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.lede {
		max-width: 680px;
		color: rgb(var(--gray-dark));
		font-size: 1.35rem;
		line-height: 1.55;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 1.25rem;
		border: 1px solid rgb(var(--black));
		border-radius: 999px;
		background: rgb(var(--black));
		color: #fff;
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 160ms ease, background 160ms ease;
	}

	.button:hover {
		color: #fff;
		transform: translateY(-2px);
	}

	.button.secondary {
		background: transparent;
		color: rgb(var(--black));
	}

	.button.secondary:hover {
		color: rgb(var(--black));
		background: rgba(0, 0, 0, 0.04);
	}

	.section {
		padding: 3.5rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.section:last-of-type {
		border-bottom: 0;
	}

	.section-heading {
		margin-bottom: 1.75rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.6rem;
		letter-spacing: -0.01em;
	}

	.expandable-grid {
		display: grid;
		gap: 1rem;
	}

	.expand-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		background: #fff;
		overflow: hidden;
		transition: border-color 200ms ease, box-shadow 200ms ease;
	}

	.expand-card:hover {
		border-color: rgb(var(--gray));
	}

	.expand-card[open] {
		border-color: var(--accent);
		box-shadow: 0 6px 20px rgba(var(--black), 0.06);
	}

	.chevron {
		flex-shrink: 0;
		width: 9px;
		height: 9px;
		margin-top: 0.35rem;
		border-right: 2px solid rgb(var(--gray));
		border-bottom: 2px solid rgb(var(--gray));
		transform: rotate(45deg);
		transition: transform 200ms ease;
	}

	.expand-card[open] .chevron {
		border-color: var(--accent);
		transform: rotate(-135deg);
	}

	.expand-summary {
		cursor: pointer;
		padding: 1.25rem 1.5rem;
		list-style: none;
		user-select: none;
	}

	.expand-summary::-webkit-details-marker {
		display: none;
	}

	.summary-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.card-title {
		margin: 0;
		color: rgb(var(--black));
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.card-tagline {
		margin: 0.5rem 0 0.85rem;
		color: rgb(var(--gray-dark));
		font-size: 1.05rem;
		line-height: 1.5;
	}

	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tech-tag {
		padding: 0.15rem 0.6rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	.private-tag {
		border-style: dashed;
	}

	.card-actions[hidden] {
		display: none;
	}

	.expand-content {
		padding: 0 1.5rem 1.5rem;
		border-top: 1px dashed rgb(var(--gray-light));
		margin-top: 0.5rem;
		padding-top: 1.25rem;
	}

	.content-block h4 {
		margin: 0 0 0.75rem;
		color: rgb(var(--black));
		font-size: 1rem;
	}

	.content-block ul {
		margin: 0;
		padding-left: 1.2rem;
		color: rgb(var(--gray-dark));
		font-size: 1rem;
		line-height: 1.6;
	}

	.content-block li {
		margin-bottom: 0.4rem;
	}

	.card-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.25rem;
	}

	.action-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.85rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		background: #fff;
		color: rgb(var(--black));
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 160ms ease;
	}

	.action-btn:hover {
		border-color: var(--accent);
		color: var(--accent-dark);
		background: rgba(var(--gray-light), 0.5);
	}

	.post-list {
		display: grid;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.post-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.15rem 0.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		color: inherit;
		text-decoration: none;
		transition: background 160ms ease, padding-left 160ms ease;
	}

	.post-row:hover {
		background: rgba(var(--gray-light), 0.45);
		padding-left: 0.9rem;
	}

	.post-title {
		margin: 0 0 0.25rem;
		color: rgb(var(--black));
		font-size: 1.08rem;
		line-height: 1.45;
	}

	.post-row:hover .post-title {
		color: var(--accent);
	}

	.post-desc {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.post-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.3rem;
		flex-shrink: 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
	}

	.post-tag {
		padding: 0.05rem 0.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 600;
		white-space: nowrap;
	}

	@media (max-width: 720px) {
		.intro {
			padding: 3rem 0 2.5rem;
		}

		.lede {
			font-size: 1.1rem;
		}

		.post-row {
			flex-direction: column;
			gap: 0.4rem;
		}

		.post-meta {
			flex-direction: row;
			align-items: center;
			gap: 0.6rem;
		}
	}
</style>
