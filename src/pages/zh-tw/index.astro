---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const SITE_DESCRIPTION_ZH =
	'Haowei Chan 的個人作品集與部落格，收錄專案、寫作與網頁實驗。';

const posts = (await getCollection('blog'))
	.filter((post) => post.data.lang === 'zh-tw')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredProjects = [
	{
		id: 'tinboker',
		title: 'TinBoker — AI 語音與 Podcast 知識庫平台',
		tagline: '結合非結構化語音轉寫、LangGraph 多 Agent 狀態圖與多層快取的 AI 原生內容處理系統。',
		tags: ['React 19', 'TypeScript', 'Vite', 'FastAPI', 'Python 3.12', 'LangGraph', 'Redis', 'Docker', 'Caddy'],
		highlights: [
			'多 Agent 拓撲分工：過濾廣告贊助、依長度動態合併章節、提煉 3-8 條關鍵洞察。',
			'Step-by-step Checkpoints：儲存 Raw / Checkpoint / Serving 三層狀態，支援失敗重播 (rerun_from)。',
			'高效能快取：FastAPI + Redis 記憶體快取，搭配 Single-Flight 鎖防範快取擊穿。'
		],
		links: [
			{ label: '造訪網站', href: 'https://tinboker.com', external: true },
			{ label: 'GitHub 專案', href: 'https://github.com/HaoweiChan/tinboker', external: true },
			{ label: '技術文章 (上)', href: '/zh-tw/blog/agentic-ingestion-pipeline-part1/' },
			{ label: '技術文章 (下)', href: '/zh-tw/blog/agentic-ingestion-pipeline-part2/' }
		]
	},
	{
		id: 'hermes',
		title: 'Hermes Agent — 常駐型個人 AI 助理系統',
		tagline: '雙入口（Discord 聊天視窗 + 排程器）、純文字 Vault 記憶與自動化資產追蹤的個人駐守助理。',
		tags: ['Python 3.11', 'Discord Gateway', 'Cron Scheduler', 'Obsidian Vault', 'Git Sweeper', 'Shioaji API', 'Schwab API'],
		highlights: [
			'頻道即角色 (Channel-as-Persona)：將 Discord 頻道劃分為黑潮交易檯 (#trading)、研報庫 (#reports)、產業分析 (#research)。',
			'自動化資產追蹤：每日定時解密元大電子對帳單 PDF、呼叫 Schwab/Shioaji API，計算 T+2 未交割款並自動繪製資產曲線。',
			'單一 Git Sweeper：寫檔與 Git 操作分離，定時自動 commit/push，杜絕多端寫入衝突。'
		],
		links: [
			{ label: '助理架構文章', href: '/zh-tw/blog/resident-personal-assistant/' },
			{ label: '資產追蹤文章', href: '/zh-tw/blog/broker-reports-and-portfolio-automation/' }
		]
	},
	{
		id: 'quant-engine',
		title: 'Quant Engine & AlphaTrader — 跨市場量化交易引擎',
		tagline: '支援台股期貨 (TXF) 與加密貨幣的回測、最佳化與 Dash 視覺化儀表板系統。',
		tags: ['Python', 'Dash', 'vn.py', 'Shioaji API', 'Binance API', 'PostgreSQL', 'Collar Strategy'],
		highlights: [
			'多市場模組化：統一介面抽象化台股 Shioaji 與幣安 Binance API 歷史資料與實時行情。',
			'策略包含 TXF 週選擇權掩護性買權 (Covered Call) 與下檔保護 (Protective Put) 的 Collar 輪動機制。',
			'Dash 互動式儀表板：即時繪製 MTM 損益、隱含波動率 (IV) 帶狀圖與現金殖利率。'
		],
		links: [
			{ label: 'GitHub 專案', href: 'https://github.com/HaoweiChan/quant-engine', external: true },
			{ label: 'TX-Collar-Trader', href: 'https://github.com/HaoweiChan/TX-Collar-Trader', external: true }
		]
	},
	{
		id: 'trading-agents',
		title: 'TradingAgents — 多 Agent 股票研究與共識辯論',
		tagline: '整合技術面、籌碼面、基本面與情緒面多 Agent 評價，進行多空辯論並產出投組建議。',
		tags: ['Python', 'Multi-Agent Debate', 'LangChain', 'JSON State Engine', 'Discord Integration'],
		highlights: [
			'四大分析師節點：分別進行技術線型、三大法人籌碼、財報獲利與社群情緒獨立評估。',
			'多空共識辯論：發起 Bull/Bear 辯論並經由 Judge 裁判節點輸出最終加減碼決策。',
			'Discord 整合：提供單一指令快速查詢結構化 JSON 歷史日誌並自動補算報告。'
		],
		links: [
			{ label: 'GitHub 專案', href: 'https://github.com/HaoweiChan/TradingAgents', external: true }
		]
	}
];
---

<!doctype html>
<html lang="zh-tw">
	<head>
		<BaseHead title={`${SITE_TITLE} | 繁體中文`} description={SITE_DESCRIPTION_ZH} />
	</head>
	<body>
		<Header locale="zh-tw" switchHref="/" />
		<main class="home">
			<section class="intro" aria-labelledby="intro-title">
				<p class="eyebrow">作品集與筆記</p>
				<h1 id="intro-title">Haowei Chan</h1>
				<p class="lede">
					我打造實用的網頁產品與 AI 系統，記錄學到的東西，並把專案、技術筆記與小型實驗公開整理在這裡。
				</p>
				<div class="actions" aria-label="主要連結">
					<a class="button" href="/zh-tw/blog">閱讀所有文章</a>
					<a class="button secondary" href="https://github.com/HaoweiChan" target="_blank" rel="noreferrer"
						>查看 GitHub</a
					>
				</div>
			</section>

			<section class="section" aria-labelledby="projects-title">
				<div class="section-heading">
					<p class="eyebrow">精選作品</p>
					<h2 id="projects-title">專案</h2>
				</div>

				<div class="expandable-grid">
					{
						featuredProjects.map((project) => (
							<details class="expand-card project-card" id={`proj-${project.id}`}>
								<summary class="expand-summary">
									<div class="summary-header">
										<h3 class="card-title">{project.title}</h3>
										<span class="chevron" aria-hidden="true" />
									</div>
									<p class="card-tagline">{project.tagline}</p>
									<div class="tag-row">
										{project.tags.map((tag) => (
											<span class="tech-tag">{tag}</span>
										))}
									</div>
								</summary>
								<div class="expand-content">
									<div class="content-block">
										<h4>核心亮點與架構細節</h4>
										<ul>
											{project.highlights.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</div>
									<div class="card-actions">
										{project.links.map((link) => (
											<a
												class="action-btn"
												href={link.href}
												target={link.external ? '_blank' : '_self'}
												rel={link.external ? 'noreferrer' : ''}
											>
												{link.label}
											</a>
										))}
									</div>
								</div>
							</details>
						))
					}
				</div>
			</section>

			<section class="section" aria-labelledby="writing-title">
				<div class="section-heading">
					<p class="eyebrow">最新發布</p>
					<h2 id="writing-title">Blog</h2>
				</div>

				<div class="post-list">
					{
						posts.map((post) => (
							<a
								class="post-row"
								href={`/zh-tw/blog/${post.data.translationOf ?? post.id.replace(/^zh-tw\//, '')}/`}
							>
								<div class="post-text">
									<h3 class="post-title">{post.data.title}</h3>
									<p class="post-desc">{post.data.description}</p>
								</div>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} locale="zh-TW" />
								</span>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer locale="zh-tw" />
	</body>
</html>

<style>
	.home {
		width: 960px;
	}

	.intro {
		padding: 5rem 0 4rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.eyebrow {
		margin: 0 0 0.85rem;
		color: var(--accent-dark);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.lede {
		max-width: 680px;
		color: rgb(var(--gray-dark));
		font-size: 1.35rem;
		line-height: 1.55;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 1.25rem;
		border: 1px solid rgb(var(--black));
		border-radius: 999px;
		background: rgb(var(--black));
		color: #fff;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 160ms ease, background 160ms ease;
	}

	.button:hover {
		color: #fff;
		transform: translateY(-2px);
	}

	.button.secondary {
		background: transparent;
		color: rgb(var(--black));
	}

	.button.secondary:hover {
		color: rgb(var(--black));
		background: rgba(0, 0, 0, 0.04);
	}

	.section {
		padding: 3.5rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.section:last-of-type {
		border-bottom: 0;
	}

	.section-heading {
		margin-bottom: 1.75rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.6rem;
		letter-spacing: -0.01em;
	}

	.expandable-grid {
		display: grid;
		gap: 1rem;
	}

	.expand-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		background: #fff;
		overflow: hidden;
		transition: border-color 200ms ease, box-shadow 200ms ease;
	}

	.expand-card:hover {
		border-color: rgb(var(--gray));
	}

	.expand-card[open] {
		border-color: var(--accent);
		box-shadow: 0 6px 20px rgba(var(--black), 0.06);
	}

	.chevron {
		flex-shrink: 0;
		width: 9px;
		height: 9px;
		margin-top: 0.35rem;
		border-right: 2px solid rgb(var(--gray));
		border-bottom: 2px solid rgb(var(--gray));
		transform: rotate(45deg);
		transition: transform 200ms ease;
	}

	.expand-card[open] .chevron {
		border-color: var(--accent);
		transform: rotate(-135deg);
	}

	.expand-summary {
		cursor: pointer;
		padding: 1.25rem 1.5rem;
		list-style: none;
		user-select: none;
	}

	.expand-summary::-webkit-details-marker {
		display: none;
	}

	.summary-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.card-title {
		margin: 0;
		color: rgb(var(--black));
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.card-tagline {
		margin: 0.5rem 0 0.85rem;
		color: rgb(var(--gray-dark));
		font-size: 0.98rem;
		line-height: 1.5;
	}

	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tech-tag {
		padding: 0.15rem 0.6rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		color: rgb(var(--gray));
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	.expand-content {
		padding: 0 1.5rem 1.5rem;
		border-top: 1px dashed rgb(var(--gray-light));
		margin-top: 0.5rem;
		padding-top: 1.25rem;
	}

	.content-block h4 {
		margin: 0 0 0.75rem;
		color: rgb(var(--black));
		font-size: 0.95rem;
	}

	.content-block ul {
		margin: 0;
		padding-left: 1.2rem;
		color: rgb(var(--gray-dark));
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.content-block li {
		margin-bottom: 0.4rem;
	}

	.card-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.25rem;
	}

	.action-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.85rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		background: #fff;
		color: rgb(var(--black));
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 160ms ease;
	}

	.action-btn:hover {
		border-color: var(--accent);
		color: var(--accent-dark);
		background: rgba(var(--gray-light), 0.5);
	}

	.post-list {
		display: grid;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.post-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.15rem 0.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		color: inherit;
		text-decoration: none;
		transition: background 160ms ease, padding-left 160ms ease;
	}

	.post-row:hover {
		background: rgba(var(--gray-light), 0.45);
		padding-left: 0.9rem;
	}

	.post-title {
		margin: 0 0 0.25rem;
		color: rgb(var(--black));
		font-size: 1.08rem;
		line-height: 1.45;
	}

	.post-row:hover .post-title {
		color: var(--accent);
	}

	.post-desc {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.88rem;
		line-height: 1.55;
	}

	.post-date {
		flex-shrink: 0;
		color: rgb(var(--gray));
		font-size: 0.82rem;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 720px) {
		.intro {
			padding: 3rem 0 2.5rem;
		}

		.lede {
			font-size: 1.1rem;
		}

		.post-row {
			flex-direction: column;
			gap: 0.4rem;
		}
	}
</style>
