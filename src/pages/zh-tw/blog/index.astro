---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => post.data.lang === 'zh-tw')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-tw">
	<head>
		<BaseHead
			title={`文章 | ${SITE_TITLE}`}
			description="Haowei Chan 的專案筆記、網頁工具紀錄與技術文章。"
		/>
	</head>
	<body>
		<Header locale="zh-tw" switchHref="/blog/" />
		<main class="blog-main">
			<div class="blog-heading">
				<div>
					<h1>文章列表 (Writing)</h1>
					<p>關於專案、網頁工具、AI 系統，以及值得留下來的實作細節。</p>
				</div>
				<button type="button" class="toggle-all-btn" onclick="toggleAllPosts()">
					✨ 全部展開 / 折疊摘要
				</button>
			</div>

			<section class="post-section">
				<div class="expandable-list" id="posts-container">
					{
						posts.map((post) => {
							const postHref = `/zh-tw/blog/${post.data.translationOf ?? post.id.replace(/^zh-tw\//, '')}/`;
							return (
								<details class="expand-card post-card">
									<summary class="expand-summary">
										<div class="post-summary-row">
											<div class="post-title-group">
												<h3 class="post-title">{post.data.title}</h3>
												<p class="post-desc">{post.data.description}</p>
											</div>
											<div class="post-meta">
												<FormattedDate date={post.data.pubDate} locale="zh-TW" />
												<span class="expand-badge">▼ 展開摘要</span>
											</div>
										</div>
									</summary>
									<div class="expand-content post-expand-body">
										<div class="abstract-box">
											<h4>📖 文章導讀與重點觀點</h4>
											<p>{post.data.description}</p>
										</div>
										<div class="post-action-row">
											<a class="read-full-btn" href={postHref}>
												閱讀全文 (Read Full Article) →
											</a>
										</div>
									</div>
								</details>
							);
						})
					}
				</div>
			</section>
		</main>
		<Footer locale="zh-tw" />

		<script is:inline>
			function toggleAllPosts() {
				const container = document.getElementById('posts-container');
				if (!container) return;
				const detailsList = container.querySelectorAll('details');
				const allOpen = Array.from(detailsList).every((d) => d.open);
				detailsList.forEach((d) => {
					d.open = !allOpen;
				});
			}
		</script>
	</body>
</html>

<style>
	main.blog-main {
		width: 960px;
	}
	.blog-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.blog-heading h1 {
		margin: 0 0 0.4rem;
	}
	.blog-heading p {
		margin: 0;
		max-width: 620px;
		color: rgb(var(--gray-dark));
	}
	.toggle-all-btn {
		cursor: pointer;
		padding: 0.4rem 0.85rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.9);
		color: var(--accent-dark);
		font-size: 0.82rem;
		font-weight: 700;
		transition: all 160ms ease;
	}
	.toggle-all-btn:hover {
		border-color: var(--accent);
		background: var(--accent);
		color: #fff;
	}
	.expandable-list {
		display: grid;
		gap: 1rem;
	}
	.expand-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.85);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
		overflow: hidden;
		transition: border-color 200ms ease, box-shadow 200ms ease;
	}
	.expand-card[open] {
		border-color: rgba(var(--accent-rgb, 35, 90, 240), 0.4);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
	}
	.expand-summary {
		cursor: pointer;
		padding: 1.25rem 1.5rem;
		list-style: none;
		user-select: none;
	}
	.expand-summary::-webkit-details-marker {
		display: none;
	}
	.post-summary-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}
	.post-title-group {
		display: grid;
		gap: 0.3rem;
	}
	.post-title {
		margin: 0;
		color: rgb(var(--black));
		font-size: 1.2rem;
	}
	.post-desc {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.92rem;
	}
	.post-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.4rem;
		flex-shrink: 0;
	}
	.expand-badge {
		color: var(--accent-dark);
		font-size: 0.8rem;
		font-weight: 700;
		transition: transform 200ms ease;
	}
	.expand-card[open] .expand-badge {
		transform: rotate(180deg);
	}
	.expand-content {
		padding: 0 1.5rem 1.5rem;
		border-top: 1px dashed rgb(var(--gray-light));
		margin-top: 0.5rem;
		padding-top: 1.25rem;
	}
	.abstract-box {
		padding: 1rem;
		border-radius: 8px;
		background: rgba(var(--gray-light), 0.4);
	}
	.abstract-box h4 {
		margin: 0 0 0.4rem;
		font-size: 0.9rem;
	}
	.abstract-box p {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
		line-height: 1.55;
	}
	.post-action-row {
		margin-top: 1rem;
		text-align: right;
	}
	.read-full-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 1rem;
		border-radius: 6px;
		background: rgb(var(--black));
		color: #fff;
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 160ms ease;
	}
	.read-full-btn:hover {
		color: #fff;
		transform: translateX(3px);
	}
	@media (max-width: 720px) {
		.blog-heading {
			flex-direction: column;
			align-items: flex-start;
		}
		.post-summary-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}
		.post-meta {
			align-items: flex-start;
			flex-direction: row;
			width: 100%;
			justify-content: space-between;
		}
	}
</style>
