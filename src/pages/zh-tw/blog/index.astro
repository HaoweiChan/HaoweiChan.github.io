---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { SITE_TITLE } from '../../../consts';
import { TAG_LABELS } from '../../../tags';

const posts = (await getCollection('blog'))
	.filter((post) => post.data.lang === 'zh-tw')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const counts = posts.reduce((acc, post) => {
	for (const tag of post.data.tags) acc[tag] = (acc[tag] ?? 0) + 1;
	return acc;
}, {});
---

<!doctype html>
<html lang="zh-tw">
	<head>
		<BaseHead
			title={`Blog | ${SITE_TITLE}`}
			description="Haowei Chan 的專案筆記、網頁工具紀錄與技術文章。"
		/>
	</head>
	<body>
		<Header locale="zh-tw" switchHref="/blog/" />
		<main class="blog-main">
			<div class="blog-heading">
				<h1>Blog</h1>
				<p>關於專案、網頁工具、AI 系統，以及值得留下來的實作細節。</p>
			</div>

			<TagFilter locale="zh-tw" counts={counts} total={posts.length} />

			<div class="post-list">
				{
					posts.map((post) => (
						<a
							class="post-row"
							data-tags={post.data.tags.join(' ')}
							href={`/zh-tw/blog/${post.data.translationOf ?? post.id.replace(/^zh-tw\//, '')}/`}
						>
							<div class="post-text">
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-desc">{post.data.description}</p>
							</div>
							<span class="post-meta">
								<FormattedDate date={post.data.pubDate} locale="zh-TW" />
								{post.data.tags.map((tag) => (
									<span class="post-tag">{TAG_LABELS['zh-tw'][tag]}</span>
								))}
							</span>
						</a>
					))
				}
			</div>
		</main>
		<Footer locale="zh-tw" />
	</body>
</html>

<style>
	main.blog-main {
		width: 960px;
	}
	.blog-heading {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.blog-heading h1 {
		margin: 0 0 0.5rem;
		font-size: 2.4rem;
		letter-spacing: -0.01em;
	}
	.blog-heading p {
		margin: 0;
		max-width: 620px;
		color: rgb(var(--gray));
		font-size: 1.05rem;
	}
	.post-list {
		display: grid;
	}
	.post-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.15rem 0.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		color: inherit;
		text-decoration: none;
		transition: background 160ms ease, padding-left 160ms ease;
	}
	.post-row:hover {
		background: rgba(var(--gray-light), 0.45);
		padding-left: 0.9rem;
	}
	.post-title {
		margin: 0 0 0.25rem;
		color: rgb(var(--black));
		font-size: 1.08rem;
		line-height: 1.45;
	}
	.post-row:hover .post-title {
		color: var(--accent);
	}
	.post-desc {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
		line-height: 1.55;
	}
	.post-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.3rem;
		flex-shrink: 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
	}
	.post-tag {
		padding: 0.05rem 0.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.post-row[hidden] {
		display: none;
	}
	@media (max-width: 720px) {
		.blog-heading h1 {
			font-size: 1.9rem;
		}
		.post-row {
			flex-direction: column;
			gap: 0.4rem;
		}
		.post-meta {
			flex-direction: row;
			align-items: center;
			gap: 0.6rem;
		}
	}
</style>
