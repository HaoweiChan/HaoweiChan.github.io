---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

interface Props {
	locale?: 'en' | 'zh-tw';
	switchHref?: string;
}

const { locale = 'en', switchHref = locale === 'en' ? '/zh-tw/' : '/' } = Astro.props;
const isZhTw = locale === 'zh-tw';
const homeHref = isZhTw ? '/zh-tw/' : '/';
const blogHref = isZhTw ? '/zh-tw/blog' : '/blog';
const blogLabel = 'Blog';
const currentHref = Astro.url.pathname;
const englishHref = isZhTw ? switchHref : currentHref;
const zhTwHref = isZhTw ? currentHref : switchHref;
---

<header>
	<nav>
		<h2><a href={homeHref}>{SITE_TITLE}</a></h2>
		<div class="nav-actions">
			<div class="internal-links">
				<HeaderLink href={blogHref}>{blogLabel}</HeaderLink>
				<HeaderLink href="https://github.com/HaoweiChan" target="_blank" rel="noreferrer"
					>GitHub</HeaderLink
				>
				<HeaderLink href="https://tinboker.com" target="_blank" rel="noreferrer">TinBoker</HeaderLink>
			</div>
			<div class="language-switch" aria-label="Language switcher">
				<a class:list={{ active: !isZhTw }} href={englishHref}>EN</a>
				<a class:list={{ active: isZhTw }} href={zhTwHref}>繁中</a>
			</div>
			<button
				type="button"
				class="theme-toggle"
				id="theme-toggle"
				aria-label={isZhTw ? '切換亮色／暗色主題' : 'Toggle light and dark theme'}
				aria-pressed="false"
			>
				<svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4.2"></circle>
					<g stroke-linecap="round">
						<path d="M12 2.2v2.4M12 19.4v2.4M4.4 12H2M22 12h-2.4M6.05 6.05 4.35 4.35M19.65 19.65l-1.7-1.7M17.95 6.05l1.7-1.7M4.35 19.65l1.7-1.7"
						></path>
					</g>
				</svg>
				<svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2Z"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<script is:inline>
	// The head script already stamped data-theme; this only handles the click.
	(() => {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		const sync = () => btn.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
		sync();
		btn.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {
				// Choice just will not persist; the toggle still works for this page.
			}
			sync();
		});
	})();
</script>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background: rgba(var(--bg), 0.86);
		border-bottom: 1px solid rgba(var(--gray-light), 80%);
		backdrop-filter: blur(18px);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 960px;
		margin: 0 auto;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 2px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
	}
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}
	.language-switch {
		display: inline-flex;
		padding: 0.15rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: rgba(var(--surface), 0.72);
		font-size: 0.88rem;
	}
	.language-switch a {
		padding: 0.18rem 0.5rem;
		border: 0;
		border-radius: 999px;
		color: rgb(var(--gray));
		line-height: 1.4;
	}
	.language-switch a.active {
		background: rgb(var(--black));
		color: rgb(var(--bg));
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: rgba(var(--surface), 0.72);
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: border-color 160ms ease, color 160ms ease;
	}
	.theme-toggle:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.icon {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
	}
	.moon {
		fill: currentColor;
		stroke: none;
	}
	/* Show the icon for the theme the click switches TO. */
	.sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .sun {
		display: block;
	}
	:global(:root[data-theme='dark']) .moon {
		display: none;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 0.75em;
		}
		nav {
			align-items: flex-start;
			flex-direction: column;
			padding: 0.65rem 0;
		}
		nav a {
			padding: 0.35em 0.5em 0.35em 0;
		}
		.nav-actions {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.45rem;
		}
		.language-switch a {
			padding: 0.12rem 0.45rem;
		}
	}
</style>
