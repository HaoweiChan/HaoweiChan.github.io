---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SeriesNav from '../components/SeriesNav.astro';
import type { seriesNav } from '../series';
import { TAG_LABELS } from '../tags';

type Props = CollectionEntry<'blog'>['data'] & {
	locale?: 'en' | 'zh-tw';
	switchHref?: string;
	series?: ReturnType<typeof seriesNav>;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	locale = 'en',
	switchHref,
	series,
	tags,
} = Astro.props;
const dateLocale = locale === 'zh-tw' ? 'zh-TW' : 'en-US';
const updatedLabel = locale === 'zh-tw' ? '最後更新於' : 'Last updated on';
---

<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				/* ~45 CJK characters per line. Wide blocks break out past it,
				   see global.css. */
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.4rem;
				margin-bottom: 1em;
			}
			.tag {
				padding: 0.1rem 0.6rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				color: rgb(var(--gray));
				font-size: 0.78rem;
				font-weight: 600;
			}
		</style>
	</head>

	<body>
		<Header locale={locale} switchHref={switchHref} />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} locale={dateLocale} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{updatedLabel} <FormattedDate date={updatedDate} locale={dateLocale} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							// /about renders through this layout too, and carries no tags.
							tags?.length > 0 && (
								<div class="tags">
									{tags.map((tag) => (
										<span class="tag">{TAG_LABELS[locale][tag]}</span>
									))}
								</div>
							)
						}
						<hr />
					</div>
					{series && <SeriesNav nav={series} locale={locale} />}
					<slot />
				</div>
			</article>
		</main>
		<Footer locale={locale} />
	</body>
</html>
