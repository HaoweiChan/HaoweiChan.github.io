---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: 'en' | 'zh-tw';
  slug: string;
  canonicalUrl: string;
}

const { post, lang, slug, canonicalUrl } = Astro.props;
const { title, description, pubDate, heroImage } = post.data;

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://haoweichan.github.io';

// Intercept rendered slot HTML
let bodyHtml = await Astro.slots.render('default');

// Replace all <pre class="mermaid">...</pre> blocks with standard <p><img ... /></p>
// (Medium importer parses standard <p><img> natively without Readability drops)
let diagramIndex = 1;
bodyHtml = bodyHtml.replace(/<pre class="mermaid"[\s\S]*?<\/pre>/gi, () => {
  const imgSrc = `${site}/diagrams/${lang}/${slug}-diagram-${diagramIndex}.png`;
  const tag = `\n<p><img src="${imgSrc}" alt="${title} - 圖 ${diagramIndex}" /></p>\n`;
  diagramIndex++;
  return tag;
});

// Ensure any relative src attributes in <img> tags are resolved to absolute URLs for Medium scraper
bodyHtml = bodyHtml.replace(/<img\s+([^>]*?)src=(["'])(\/[^"']+)\2/gi, (match, before, quote, relativeSrc) => {
  return `<img ${before}src=${quote}${site}${relativeSrc}${quote}`;
});

let heroImageUrl: string | null = null;
if (heroImage) {
  if (typeof heroImage === 'object' && 'src' in heroImage) {
    heroImageUrl = `${site}${heroImage.src}`;
  } else if (typeof heroImage === 'string') {
    heroImageUrl = heroImage.startsWith('http') ? heroImage : `${site}${heroImage.startsWith('/') ? '' : '/'}${heroImage}`;
  }
}
---

<!doctype html>
<html lang={lang === 'zh-tw' ? 'zh-TW' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.7;
        color: #1a202c;
        max-width: 780px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }
      img { max-width: 100%; height: auto; }
      pre { background: #f7fafc; padding: 1rem; border-radius: 6px; overflow-x: auto; }
      blockquote { border-left: 4px solid #cbd5e0; padding-left: 1rem; color: #4a5568; }
    </style>
  </head>
  <body>
    <article>
      <h1>{title}</h1>
      <p><em>{description}</em></p>
      {heroImageUrl && (
        <p><img src={heroImageUrl} alt={title} /></p>
      )}
      <div set:html={bodyHtml} />
    </article>
  </body>
</html>
