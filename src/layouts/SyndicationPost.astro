---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: 'en' | 'zh-tw';
  slug: string;
  canonicalUrl: string;
}

const { post, lang, slug, canonicalUrl } = Astro.props;
const { title, description, pubDate, heroImage } = post.data;

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://haoweichan.github.io';

// Intercept rendered slot HTML
let bodyHtml = await Astro.slots.render('default');

// Replace all <pre class="mermaid">...</pre> blocks with absolute <img> tags
let diagramIndex = 1;
bodyHtml = bodyHtml.replace(/<pre class="mermaid"[\s\S]*?<\/pre>/gi, () => {
  const imgSrc = `${site}/diagrams/${lang}/${slug}-diagram-${diagramIndex}.png`;
  const tag = `\n<figure style="margin: 2rem 0; text-align: center;"><img src="${imgSrc}" alt="${title} - Diagram ${diagramIndex}" style="max-width: 100%; height: auto; border: 1px solid #e2e8f0; border-radius: 8px;" /></figure>\n`;
  diagramIndex++;
  return tag;
});

// Ensure any relative src attributes in <img> tags are resolved to absolute URLs for Medium scraper
bodyHtml = bodyHtml.replace(/<img\s+([^>]*?)src=(["'])(\/[^"']+)\2/gi, (match, before, quote, relativeSrc) => {
  return `<img ${before}src=${quote}${site}${relativeSrc}${quote}`;
});

let heroImageUrl: string | null = null;
if (heroImage) {
  // If heroImage is an ImageMetadata object from Astro
  if (typeof heroImage === 'object' && 'src' in heroImage) {
    heroImageUrl = `${site}${heroImage.src}`;
  } else if (typeof heroImage === 'string') {
    heroImageUrl = heroImage.startsWith('http') ? heroImage : `${site}${heroImage.startsWith('/') ? '' : '/'}${heroImage}`;
  }
}
---

<!doctype html>
<html lang={lang === 'zh-tw' ? 'zh-TW' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.7;
        color: #1a202c;
        max-width: 780px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }
      h1 { font-size: 2.25rem; line-height: 1.25; margin-bottom: 0.5rem; }
      .subtitle { font-size: 1.2rem; color: #4a5568; margin-bottom: 2rem; font-style: italic; }
      .meta { font-size: 0.9rem; color: #718096; margin-bottom: 2rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 1rem; }
      .hero { margin-bottom: 2.5rem; text-align: center; }
      .hero img { max-width: 100%; height: auto; border-radius: 12px; }
      pre { background: #f7fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 1rem; overflow-x: auto; }
      code { font-family: Menlo, Monaco, Consolas, monospace; font-size: 0.9em; }
      blockquote { border-left: 4px solid #cbd5e0; margin: 1.5rem 0; padding-left: 1rem; color: #4a5568; }
      table { border-collapse: collapse; width: 100%; margin: 1.5rem 0; }
      th, td { border: 1px solid #e2e8f0; padding: 0.5rem 0.75rem; text-align: left; }
      th { background: #f7fafc; }
    </style>
  </head>
  <body>
    <article>
      <header>
        <h1>{title}</h1>
        <p class="subtitle">{description}</p>
        <div class="meta">
          Published: <time datetime={pubDate.toISOString()}>{pubDate.toDateString()}</time> &bull; By Haowei Chan
        </div>
        {heroImageUrl && (
          <div class="hero">
            <img src={heroImageUrl} alt={title} />
          </div>
        )}
      </header>
      <div class="article-body" set:html={bodyHtml} />
    </article>
  </body>
</html>
